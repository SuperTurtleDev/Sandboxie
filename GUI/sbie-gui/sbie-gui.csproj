    GNU General Public License for more details.

    You should have received a copy of the GNU General Public License
    along with this program.  If not, see <https://www.gnu.org/licenses/>.
    SPDX-License-Identifier: GPL-3.0-or-later

    Unpackaged deployment (per MS Learn "deploy-unpackaged-apps", WinAppSDK 1.8):
      WindowsPackageType=None            -> no MSIX; enables the official auto-bootstrap
                                            initializer (calls the bootstrapper API at startup)
      WindowsAppSdkSelfContained=true    -> the Windows App SDK runtime ships in the app folder,
                                            so the bootstrap always resolves locally
      SelfContained=false                -> .NET 8 desktop runtime stays framework-dependent
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>sbie_gui</RootNamespace>
    <AssemblyName>sbie-gui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- WinUI 3 does not support AnyCPU; force x64 so plain `dotnet build` works -->
    <Platform Condition=" '$(Platform)' == '' or '$(Platform)' == 'AnyCPU' ">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- unpackaged + self-contained Windows App SDK -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

</Project>
