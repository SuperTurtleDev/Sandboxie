  taskmgr 式外壳：NavigationView(Left) + Frame 四页导航。
  Win11 风格：Mica 背景、ExtendViewIntoTitleBar+AppTitle、ThemeResource 配色、
  Segoe Fluent 图标（E8E5 沙盒列表 / E9D9 进程 / E713 沙盒设置 / F8B0 全局设置）。
-->
<Window
    x:Class="sbie_gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:sbie_gui.Pages"
    Title="Sandboxie OSS 管理器 (sbie-gui)">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏（ExtendViewIntoTitleBar + AppTitle） -->
        <TextBlock x:Name="AppTitle"
                   Grid.Row="0"
                   Text="Sandboxie OSS 管理器"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0" />

        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        IsBackButtonVisible="Auto"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsSettingsVisible="True"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavProcesses" Content="进程管理" Tag="processes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBoxes" Content="沙盒列表" Tag="boxes" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBoxSettings" Content="沙盒设置" Tag="boxsettings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
